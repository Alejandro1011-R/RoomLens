---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import RealityGap from '../components/RealityGap.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Modes from '../components/Modes.astro';
import Market from '../components/Market.astro';
import Team from '../components/Team.astro';
import Closer from '../components/Closer.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Nav />
  <main id="top">
    <Hero />
    <RealityGap />
    <HowItWorks />
    <Modes />
    <Market />
    <Team />
    <Closer />
  </main>
  <Footer />
</Base>

<script>
  import { initTheme } from '../scripts/theme';
  import { initScenes } from '../scripts/scenes';

  initTheme();
  initScenes();
</script>
