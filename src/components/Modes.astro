<!-- ══ TWO MODES ════════════════════════════════════════════ -->
<section id="modes">
  <div class="wrap">
    <div class="sec-head">
      <span class="label">The experience</span>
      <h2>Two ways to step into the room.</h2>
    </div>
    <div class="modes">
      <article class="mode">
        <span class="tagline">Mode 1 · Any device</span>
        <h3>Explore from wherever you are</h3>
        <p>Rotate, zoom and walk through the room from a phone or a laptop, right inside the listing. Nothing to install.</p>
        <div class="devices"><span>iOS</span><span>Android</span><span>Browser</span></div>
      </article>
      <article class="mode vr">
        <span class="tagline">Mode 2 · Immersive</span>
        <h3>Step inside with VR</h3>
        <p>With a headset the room appears life-size. You feel whether you can stand beside the bed and squeeze past the desk. A photo can't tell you that.</p>
        <div class="devices"><span>WebXR</span><span>Meta Quest</span><span>1:1 scale</span></div>
      </article>
    </div>
  </div>
</section>

