---
/**
 * Team — static, server-rendered roster.
 *
 * Ported from landing.html, where an empty <div id="teamGrid"> was filled
 * on the client and each portrait was drawn procedurally into a <canvas>.
 * Real photos exist now, so the canvas and drawAvatar() are gone: every
 * card below is plain markup produced at build time.
 *
 * Edit people in src/data/team.ts, not here.
 */
import { TEAM } from '../data/team';

// GitHub Pages serves the site from /RoomLens, so every asset URL has to
// carry the base path. Trailing slash stripped so template joins are clean.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- ══ TEAM ═════════════════════════════════════════════════ -->
<section id="team">
  <div class="wrap">
    <div class="sec-head">
      <span class="label">The team</span>
      <h2>Six people making the room stop lying.</h2>
      <p class="lede">
        Computer vision that rebuilds the space, and growth that puts it in front of
        room owners and platforms.
      </p>
    </div>

    <div class="team">
      {TEAM.map((member) => (
        <article class="member">
          {member.photo ? (
            <div class="portrait">
              <img
                src={`${base}/team/${member.photo}`}
                alt={member.name}
                loading="lazy"
                decoding="async"
              />
            </div>
          ) : (
            /* No photo yet: same square box, initials on the inset ground.
               Decoration only — the name is in the heading below. */
            <div class="portrait portrait-pending">
              <span class="initials" aria-hidden="true">{member.initials}</span>
            </div>
          )}

          <span class="role">{member.role}</span>
          <h3>{member.name}</h3>
          {!member.photo && <span class="pending">photo pending</span>}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Team ─────────────────────────────────────────────────
     Ported verbatim from landing.html, with `.member canvas`
     re-pointed at the `.portrait` container that now holds an
     <img>. Square 1:1 box on the same --inset ground, same
     hairline, 2px radius and 18px gap below.                  */
  .team {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(26px, 3.4vw, 44px);
  }
  @media (max-width: 900px) {
    .team { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 540px) {
    .team { grid-template-columns: 1fr; }
  }

  .member { display: flex; flex-direction: column; }

  .member .portrait {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: block;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--inset);
    margin-bottom: 18px;
    overflow: hidden;
  }
  .member .portrait img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* Pending: initials centred on the same ground. */
  .member .portrait-pending {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .member .initials {
    font-family: var(--f-mono);
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--haze);
  }

  /* Two lines reserved: the longest titles wrap, and without this the
     names sit at different heights from one grid cell to the next. */
  .member .role {
    display: block;
    min-height: 2.4em;
    font-family: var(--f-mono);
    font-size: .65rem;
    line-height: 1.2;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .member h3 {
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: -.015em;
    margin-top: 4px;
  }
  .member .pending {
    align-self: flex-start;
    margin-top: 12px;
    font-family: var(--f-mono);
    font-size: .6rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--haze);
    border-bottom: 1px dashed var(--line-strong);
    padding-bottom: 2px;
  }
</style>
