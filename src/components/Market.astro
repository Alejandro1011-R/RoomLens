.track{display:flex; flex-direction:column; gap:16px; padding-top:22px; border-top:1px solid var(--ink)}
.track .kind{font-family:var(--f-mono); font-size:.67rem; letter-spacing:.14em; text-transform:uppercase; color:var(--accent-ink)}
.track h3{font-size:1.4rem; font-weight:500; letter-spacing:-.025em}
.track p{color:var(--ink-soft); font-size:.96rem; line-height:1.68}
.track ul{margin:0; padding:0; list-style:none; display:flex; flex-direction:column}
.track li{font-size:.93rem; color:var(--ink-soft); padding:11px 0; border-top:1px solid var(--line)}
.track li:first-child{border-top:0; padding-top:0}
.badge3d{
  display:inline-flex; align-items:center; gap:9px; align-self:flex-start;
  padding:7px 14px 7px 11px; border-radius:2px;
  border:1px solid var(--depth); color:var(--depth);
  font-size:.82rem; font-weight:500; letter-spacing:.01em;
}
.partners{font-family:var(--f-mono); font-size:.68rem; color:var(--haze); letter-spacing:.04em; margin-top:4px}
</style>
