<!-- ══ MARKET ═══════════════════════════════════════════════ -->
<section id="market">
  <div class="wrap">
    <div class="sec-head">
      <span class="label">Go to market</span>
      <h2>Two routes, one engine.</h2>
      <p class="lede">We sell scans directly to whoever owns the room, which earns from the first
      one and puts the pipeline in front of real users. The same engine then goes to the
      platforms that already own the traffic.</p>
    </div>
    <div class="gtm">
      <article class="track">
        <span class="kind">Route A · B2C · now</span>
        <h3>Pay per scan, self-serve</h3>
        <p>Any owner, host or agent uploads their own photos and pays a small fee for an accurate 3D model. No listing, no matching, no marketplace to fill first.</p>
        <ul>
          <li>One customer, one transaction — nothing to bootstrap</li>
          <li>Usage-based revenue from the first scan</li>
          <li>Reaches beyond rentals: short-let hosts, agents, managers</li>
        </ul>
        <p class="partners">Individual hosts · agents · small agencies</p>
      </article>
      <article class="track">
        <span class="kind">Route B · B2B · next</span>
        <h3>Power existing platforms</h3>
        <p>License the same 3D engine to rental portals, which offer it to their listers as a verified-listing badge.</p>
        <span class="badge3d">
          <svg width="15" height="15" viewBox="0 0 48 48" aria-hidden="true">
            <g fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round">
              <rect x="6" y="6" width="36" height="36" rx="8"/><rect x="19" y="17" width="15" height="13" rx="2"/>
            </g>
          </svg>
          Verified in 3D
        </span>
        <ul>
          <li>SDK and embed API integration</li>
          <li>Revenue per processed scan plus annual licence</li>
          <li>The portal gains trust without building a vision team</li>
        </ul>
        <p class="partners">Badi · Spotahome · HousingAnywhere · Idealista</p>
      </article>
    </div>
  </div>
</section>

<style>
/* ── Go-to-market ─────────────────────────────────────────── */
